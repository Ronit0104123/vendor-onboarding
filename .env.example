# Copy to .env and fill in. Never commit .env.
ENV=dev                                   # "prod" enables Secure cookies, HSTS, and requires the keys below
BUYER_NAME="Acme Industries Pvt Ltd"
PUBLIC_APP_URL=http://localhost:5173      # used to build vendor portal links (use :8000 when the API serves the UI)
FRONTEND_ORIGIN=http://localhost:5173     # CORS allowlist (only needed for cross-origin setups)
DATABASE_URL=sqlite:///./data/app.db      # prod: postgresql://... (Neon / Supabase)

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=

LLM_MODE=openai                           # or "mock": runs offline, no key needed
OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-5.4
OPENAI_MODEL_TEXT=gpt-5.4-mini

# Documents: "local" (dev) or "s3" (any S3-compatible store: AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional real email delivery (otherwise messages are only logged to the in-app outbox)
RESEND_API_KEY=
EMAIL_FROM="Acme Procurement <onboarding@example.com>"
INTERNAL_ALERT_EMAIL=procurement@example.com

# Behaviour
FOUR_EYES_OVERRIDES=true                  # overrides need a second admin
REMINDER_DAYS=3
MAX_ATTEMPTS=3
GST_VERIFIER=sandbox                      # "sandbox" or "none"
BANK_VERIFIER=sandbox

# Demo users, created by `make seed` (choose your own passwords)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CHECKER_EMAIL=
DEMO_CHECKER_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
